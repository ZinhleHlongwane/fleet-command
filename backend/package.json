{
  "name": "fleet-command-backend",
  "version": "1.0.0",
  "description": "Express + PostgreSQL API for the Fleet Command drone dispatch system",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "scripts": {
  "dev": "nodemon --exec tsx src/server.ts",
  "build": "tsc",
  "start": "node dist/src/server.js",
  "db:init": "tsx src/db/init.ts",
  "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
