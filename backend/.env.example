# Copy this file to .env and fill in your own values before running the server

# --- PostgreSQL connection ---
PGHOST=localhost
PGPORT=5432
PGUSER=fleet_user
PGPASSWORD=fleet_password
PGDATABASE=fleet_command

# --- Server ---
PORT=5000

# --- Auth ---
# Any long random string works here. This signs the login tokens.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
